# GiftListApp environment variables (Supabase migration).
# Copy to `.env` (gitignored). EXPO_PUBLIC_* vars are inlined into the JS bundle.

# --- Supabase (client) ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# --- Telemetry (client) ---
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------------------------------------------------------
# The following are NOT bundled into the app. They are set as Supabase secrets
# (supabase secrets set ...) for Edge Functions, or in migration/.env for ETL.
#
# Edge Function secrets:
#   GEMINI_API_KEY=...                 # AI functions (Gemini)
#   GOOGLE_SHEETS_SA_JSON=...          # service-account JSON for sync-feedback-to-sheets
#   FEEDBACK_SHEET_ID=...              # target spreadsheet id
#   (SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are auto-injected)
#
# migration/.env (ETL load step):
#   SUPABASE_URL=...
#   SUPABASE_SERVICE_ROLE_KEY=...
# ---------------------------------------------------------------------------
