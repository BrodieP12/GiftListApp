# PostHog Analytics (Expo client)
EXPO_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# PostHog AI Observability (Firebase Functions)
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Edge Function Secrets (Configured in Supabase Dashboard / CLI secrets, not client env)
# GEMINI_API_KEY=your-gemini-api-key
# TAVILY_API_KEY=your-tavily-api-key
# SIGHTENGINE_API_USER=your-sightengine-user
# SIGHTENGINE_API_SECRET=your-sightengine-secret

